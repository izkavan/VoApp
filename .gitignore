# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled output
/tmp
/out-tsc
/dist
/build
/src/*.js

# Dependencies
/node_modules
/.pnp
.pnp.js

# IDE / Editor specific
# Ignore the .vscode directory, but allow team-shared settings
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/launch.json

# Secrets / Environment variables
# Never commit secrets, tokens, or API keys!
voAppToke
.env
.env.*.local

# OS generated files
.DS_Store
Thumbs.db

# Custom Ignore Additions
/.idea
/.agents
/voApp
/*.js.map
/index.js.map

# Testing & Coverage Artifacts
/test-results
/playwright-report
/coverage
