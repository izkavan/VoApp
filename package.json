{
  "name": "Vo-App",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "tauri": "tauri",
    "build": "rm -rf dist && tsc && cp src/index.html dist/ && cp src/styles.css dist/ && cp -r src/images dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && make-coverage-badge",
    "tauri:build:mac-universal": "tauri build --target universal-apple-darwin",
    "tauri:build:mac-intel": "tauri build --target x86_64-apple-darwin"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "make-coverage-badge": "^1.2.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  },
  "private": true
}
